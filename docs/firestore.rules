// 《子彈喵喵》雲端排行榜的 Firestore 安全規則
// 貼到 Firebase 控制台 → Firestore Database → 規則，按「發布」。
// 只允許：所有人可讀；新增一筆合法成績；不允許修改或刪除。
rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /scores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'score', 'wave', 'ts'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 4
        && request.resource.data.name.matches('^[A-Z0-9 ]+$')
        && request.resource.data.score is int
        && request.resource.data.score > 0
        && request.resource.data.score <= 9999999
        && request.resource.data.wave is int
        && request.resource.data.wave >= 1
        && request.resource.data.wave <= 999
        && request.resource.data.ts == request.time;
      allow update, delete: if false;
    }
  }
}
